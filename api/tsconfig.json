{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["workspace"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../apps/api/src/**/*", "../packages/db/src/**/*", "../packages/api-zod/src/**/*"]
}
