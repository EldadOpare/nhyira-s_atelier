# Copy this file to .env and fill in your own values.

# Database (Supabase Postgres). Use the Transaction mode string on port 6543.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres

# Supabase keys. You will find these in Project Settings, under API.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend. Leave VITE_API_URL empty in production to use the same domain.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API server port.
PORT=3000

# Only these emails can reach the admin. Without it, the admin is locked.
ADMIN_EMAILS=you@example.com

# The domains allowed to call the API from a browser. Needed in production.
# ALLOWED_ORIGINS=https://your-domain.vercel.app
