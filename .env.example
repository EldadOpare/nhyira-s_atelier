# Required environment variables
# Copy this file to .env and fill in the values

# --- Database (Supabase PostgreSQL) ---
# Use the "Transaction mode" connection string from Supabase (port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Frontend (Vite) ---
# Base URL of the API server (leave empty to use same origin in production)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- API Server ---
# Port for the API server (defaults to 3000)
PORT=3000
